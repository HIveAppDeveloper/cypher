# Backend settings; no secrets in Git. Pull/import both Vercel sources first.
# Native PostgreSQL URL only. Prisma Accelerate proxy URLs are unsupported.
# GROKBOT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SCHEMA=grokbot
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
# Direct provider key, or HIVE_OPENAI_API_KEY / ATLAS_OPENAI_API_KEY / OPENAI_API_KEY.
LLM_API_KEY=
# On Vercel use Gateway with deployment OIDC (rotating token file for the worker),
# or configure AI_GATEWAY_API_KEY privately on both backend and worker.
LLM_USE_GATEWAY=false
# Optional backup; disabled unless configured. Only compatible inputs are routed.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=gpt-6-luna
# Audio uploads are transcribed once, then read by the OpenAI chat manager.
AUDIO_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
SANDBOX_IMAGE=open-grokbot-sandbox:latest
# Set public API URL at frontend build time only if deploying separately.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Required when the private backend is reached through a hosted gateway.
# BACKEND_API_TOKEN=GENERATE_ON_YOUR_PRIVATE_HOST

# Passwordless multi-user mode (production). Keep AUTH_SESSION_SECRET server-only.
REQUIRE_USER_AUTH=true
AUTH_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
GROKBOT_PUBLIC_URL=https://your-app.vercel.app
GROKBOT_AUTH_FROM=no-reply@your-verified-domain.example
AUTH_MAGIC_LINK_TTL_MINUTES=15
# Optional: migrate the legacy single-user workspace after sign-in with the verified matching email.
# LEGACY_OWNER_EMAIL=owner@example.com

# Disabled integration draft. Requires separate provider/data-sharing approval
# before any real user traffic; configuring a key alone never enables it.
# Set ENABLED on both frontend proxy and backend; other values are backend-only.
GROKBOT_ATLAS_ENGINE_ENABLED=false
ATLAS_ENGINE_SIGNING_KEY=
GROKBOT_ATLAS_ENGINE_PROVIDER=
GROKBOT_ATLAS_ENGINE_MODEL=
# Production fails closed without the shared PostgreSQL admission schema.
GROKBOT_ATLAS_ENGINE_ADMISSION=postgres
# Synthetic local fixtures only; rejected on hosted/public-origin configs.
GROKBOT_ATLAS_ENGINE_ALLOW_LOCAL_ADMISSION=false
