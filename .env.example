# Application Settings
SECRET_KEY=super-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_USER=grokbot
POSTGRES_PASSWORD=grokbot_secret
POSTGRES_DB=grokbot_db
DATABASE_URL=postgresql://grokbot:grokbot_secret@postgres:5432/grokbot_db

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3 Compatible Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000

# LLM Configuration
# Choose your provider: openai, anthropic, ollama, etc.
LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-api-key-here
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3:8b
# LLM_API_BASE=http://host.docker.internal:11434

# Sandbox Configuration
SANDBOX_IMAGE=open-grokbot-sandbox:latest
