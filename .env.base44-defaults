# Local development placeholders for the Base44 compose stack.
# These are NOT secrets. Real values are delivered by the platform through
# /run/base44/app.env, which compose loads AFTER this file and therefore wins.

# Backend
DATABASE_SCHEMA=grokbot
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
# Empty placeholder: the app boots without it, agent runs need a real value.
LLM_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
SANDBOX_BACKEND=docker
RUN_EMBEDDED_WORKER=true
REQUIRE_USER_AUTH=false
CORS_ORIGINS=http://localhost:3000
# Development-only signing key so the local auth pages do not error.
AUTH_SESSION_SECRET=base44-local-development-session-secret-change-me
GROKBOT_PUBLIC_URL=http://localhost:3000
GROKBOT_ATLAS_ENGINE_ENABLED=false

# Frontend
# Empty means "call the same-origin /api proxy", which forwards to BACKEND_INTERNAL_URL.
NEXT_PUBLIC_API_URL=
