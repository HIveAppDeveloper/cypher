# Copy to .env (here or in the parent folder). Keys stay on your machine.
SEC_USER_AGENT=""   # required for `build`; the SEC needs a contact
AKTA_API_KEY=                                # optional: akta.pro enrichment for finalists
# AKTA_MONTHLY_CREDITS=1250                  # your plan's monthly credit allowance
# AKTA_RESERVE_CREDITS=100                   # credits never spent, as a safety margin
# Claude judges the final 50. Set one of these:
ANTHROPIC_API_KEY=                           # Anthropic API directly
NICRRON_API_KEY=                             # hackathon gateway (uses anthropic/claude-opus-5-5)
# JUDGE_PROVIDER=nicrron                     # optional: force one when both keys are set
