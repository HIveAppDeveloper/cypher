{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": false},
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci",
      "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
      "bindings": [{"type": "service", "service": "backend", "format": "url", "env": "BACKEND_INTERNAL_URL"}]
    },
    "backend": {"root": "backend", "runtime": "container", "entrypoint": "Dockerfile"}
  },
  "daemons": {
    "agent-worker": {
      "root": "backend",
      "entrypoint": "Dockerfile",
      "command": ["python", "-m", "app.worker_main"],
      "instances": {"iad1": 2},
      "resources": {"requests": {"memory": "2Gi"}},
      "terminationGracePeriodSeconds": 60
    }
  },
  "routes": [
    {"src":"^/$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/about$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/contact$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/privacy$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/docs$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/docs/api$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/docs/auth$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]},
    {"src":"^/docs/mcp$","methods":["GET","HEAD"],"caseSensitive":true,"continue":true,"transforms":[{"type":"response.headers","op":"append","target":{"key":"Vary"},"args":"Accept"}]}
  ],
  "rewrites": [{"source": "/(.*)", "destination": {"service": "frontend"}}]
}
